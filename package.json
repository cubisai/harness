{
  "name": "aiharness",
  "productName": "AI Harness",
  "version": "0.1.2",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "description": "A minimal desktop coding-agent harness.",
  "license": "MIT",
  "author": "AI Harness contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/cubisai/harness.git"
  },
  "desktopName": "aiharness.desktop",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "fix:node-pty": "node scripts/fix-node-pty.mjs",
    "postinstall": "pnpm run fix:node-pty",
    "predev": "pnpm run fix:node-pty",
    "prebuild": "pnpm run fix:node-pty",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "smoke": "electron . --smoke",
    "dist": "pnpm run build && electron-builder --publish never",
    "preview:ui": "vite --config vite.preview.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.281",
    "@anthropic-ai/sdk": "0.128.0",
    "@modelcontextprotocol/sdk": "1.30.1",
    "electron-updater": "^6.8.9",
    "node-pty": "1.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "zustand": "5.0.15"
  }
}
