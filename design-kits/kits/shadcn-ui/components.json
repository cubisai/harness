      "snippet": "<button data-ui=\"button\" data-variant=\"outline\" data-dialog-open=\"tb-sheet\">Invoice details</button>\n<dialog data-ui=\"sheet\" id=\"tb-sheet\">\n  <div data-part=\"header\">\n    <h2 data-part=\"title\">TB-1042</h2>\n    <p data-part=\"description\">Northline Studio, sent 12 February.</p>\n  </div>\n  <div data-part=\"content\">\n    <div data-ui=\"stack\" data-gap=\"sm\">\n      <p data-ui=\"text\" data-size=\"sm\">Spring catalogue shoot</p>\n      <p data-ui=\"text\" data-size=\"sm\" data-tone=\"muted\">Three days on location, forty edited frames.</p>\n    </div>\n  </div>\n  <div data-part=\"footer\">\n    <button data-ui=\"button\" data-variant=\"outline\" data-dialog-close>Close</button>\n    <button data-ui=\"button\">Send reminder</button>\n  </div>\n</dialog>"
