            "sm",
            "lg"
          ],
          "default": "default"
        }
      ],
      "snippet": "<div data-ui=\"stack\" data-direction=\"row\" data-gap=\"sm\" data-align=\"center\" data-wrap=\"true\">\n  <button data-ui=\"toggle\" aria-pressed=\"true\">\n    <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6 3v18\"/><path d=\"M6 8h11l-2 4 2 4H6\"/></svg>\n    Flagged\n  </button>\n  <button data-ui=\"toggle\" data-variant=\"outline\" aria-pressed=\"false\">\n    <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 2v10\"/><path d=\"M18.4 6a9 9 0 1 1-12.8 0\"/></svg>\n    Reminders on\n  </button>\n  <button data-ui=\"toggle\" data-size=\"sm\" aria-pressed=\"false\">Small</button>\n  <button data-ui=\"toggle\" data-size=\"lg\" aria-pressed=\"false\">Large</button>\n</div>"
    },
    {
      "name": "Toggle group",
      "ui": "toggle-group",
      "category": "Forms",
      "description": "A row of joined toggles that share one border and radius.",
      "props": [],
      "snippet": "<div data-ui=\"toggle-group\" data-variant=\"outline\" role=\"group\" aria-label=\"Invoice list density\">\n  <button data-ui=\"toggle\" data-variant=\"outline\" aria-pressed=\"true\">\n    <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M8 6h13\"/><path d=\"M8 12h13\"/><path d=\"M8 18h13\"/><path d=\"M3 6h.01\"/><path d=\"M3 12h.01\"/><path d=\"M3 18h.01\"/></svg>\n    List\n  </button>\n  <button data-ui=\"toggle\" data-variant=\"outline\" aria-pressed=\"false\">\n    <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\"/></svg>\n    Grid\n  </button>\n</div>"
    },
    {
      "name": "Tabs",
      "ui": "tabs",
      "category": "Navigation",
      "description": "A row of tabs over their panels, switched by keyboard or click.",
      "props": [],
      "snippet": "<div data-ui=\"tabs\">\n  <div data-part=\"list\" role=\"tablist\" aria-label=\"Invoice views\">\n    <button role=\"tab\" id=\"tb-tab-all\" aria-controls=\"tb-panel-all\" aria-selected=\"true\" tabindex=\"0\">All</button>\n    <button role=\"tab\" id=\"tb-tab-open\" aria-controls=\"tb-panel-open\" aria-selected=\"false\" tabindex=\"-1\">Open</button>\n    <button role=\"tab\" id=\"tb-tab-paid\" aria-controls=\"tb-panel-paid\" aria-selected=\"false\" tabindex=\"-1\">Paid</button>\n  </div>\n  <div role=\"tabpanel\" id=\"tb-panel-all\" aria-labelledby=\"tb-tab-all\">\n    <p data-ui=\"text\" data-size=\"sm\">Twelve invoices this quarter, worth $18,420.00.</p>\n  </div>\n  <div role=\"tabpanel\" id=\"tb-panel-open\" aria-labelledby=\"tb-tab-open\" hidden>\n    <p data-ui=\"text\" data-size=\"sm\">Four are open: two pending and two overdue.</p>\n  </div>\n  <div role=\"tabpanel\" id=\"tb-panel-paid\" aria-labelledby=\"tb-tab-paid\" hidden>\n    <p data-ui=\"text\" data-size=\"sm\">Eight were paid, the latest on 28 February.</p>\n  </div>\n</div>"
    },
    {
      "name": "Accordion",
      "ui": "accordion",
      "category": "Disclosure",
      "description": "Stacked sections on native details and summary, separated by hairlines.",
      "props": [],
      "snippet": "<div data-ui=\"accordion\">\n  <details data-part=\"item\" name=\"tb-accordion\" open>\n    <summary>When is an invoice marked overdue?</summary>\n    <div data-part=\"content\">On the first day after the due date. Tallybook then sends one reminder and adds the invoice to your open balance.</div>\n  </details>\n  <details data-part=\"item\" name=\"tb-accordion\">\n    <summary>Can a client pay by card?</summary>\n    <div data-part=\"content\">Yes. Turn on card payments for a client and the PDF shows a link that takes them to a hosted checkout.</div>\n  </details>\n  <details data-part=\"item\" name=\"tb-accordion\">\n    <summary>How do I correct a sent invoice?</summary>\n    <div data-part=\"content\">Void it and issue a replacement. Voided invoices stay in the list with a strikethrough total.</div>\n  </details>\n</div>"
    },
    {
      "name": "Alert",
      "ui": "alert",
      "category": "Feedback",
      "description": "An inline message with a title and description, in two variants.",
      "props": [
        {
          "name": "variant",
          "label": "Variant",
          "type": "choice",
          "options": [
            "default",
            "destructive"
          ],
          "default": "default"
        }
      ],
      "snippet": "<div data-ui=\"stack\" data-gap=\"md\">\n  <div data-ui=\"alert\" role=\"status\">\n    <div data-ui=\"stack\" data-gap=\"xs\">\n      <p data-part=\"title\">Three reminders are queued</p>\n      <p data-part=\"description\">They go out tomorrow at 09:00 for the Northline, Field and Copper invoices.</p>\n    </div>\n  </div>\n  <div data-ui=\"alert\" data-variant=\"destructive\" role=\"alert\">\n    <div data-ui=\"stack\" data-gap=\"xs\">\n      <p data-part=\"title\">Card payment failed</p>\n      <p data-part=\"description\">The card on file for Copper and Grain was declined. Update it before the next run.</p>\n    </div>\n  </div>\n</div>"
    },
    {
      "name": "Alert dialog",
      "ui": "alert-dialog",
      "category": "Overlay",
      "description": "A modal that asks for a decision, with a cancel and a confirm action.",
      "props": [],
      "snippet": "<button data-ui=\"button\" data-variant=\"destructive\" data-dialog-open=\"tb-void-dialog\">Void invoice</button>\n<dialog data-ui=\"alert-dialog\" id=\"tb-void-dialog\">\n  <div data-part=\"header\">\n    <h2 data-part=\"title\">Void invoice TB-1042?</h2>\n    <p data-part=\"description\">The client will see it marked as void, and the $2,480.00 leaves your open balance.</p>\n  </div>\n  <div data-part=\"footer\">\n    <button data-ui=\"button\" data-variant=\"outline\" data-dialog-close>Cancel</button>\n    <button data-ui=\"button\" data-variant=\"destructive\">Void invoice</button>\n  </div>\n</dialog>"
    },
    {
      "name": "Dialog",
      "ui": "dialog",
      "category": "Overlay",
      "description": "A centred modal on the native dialog element, with header, content and footer.",
      "props": [],
      "snippet": "<button data-ui=\"button\" data-dialog-open=\"tb-dialog\">New invoice</button>\n<dialog data-ui=\"dialog\" id=\"tb-dialog\">\n  <div data-part=\"header\">\n    <h2 data-part=\"title\">New invoice</h2>\n    <p data-part=\"description\">Start from a blank invoice or copy the last one for this client.</p>\n  </div>\n  <div data-part=\"content\">\n    <div data-ui=\"field\">\n      <label data-part=\"label\" for=\"tb-dialog-client\">Client</label>\n      <input data-ui=\"input\" id=\"tb-dialog-client\" type=\"text\" value=\"Northline Studio\">\n    </div>\n  </div>\n  <div data-part=\"footer\">\n    <button data-ui=\"button\" data-variant=\"outline\" data-dialog-close>Cancel</button>\n    <button data-ui=\"button\">Create invoice</button>\n  </div>\n</dialog>"
    },
