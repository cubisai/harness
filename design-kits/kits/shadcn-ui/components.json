      "snippet": "<div data-ui=\"stack\" data-direction=\"row\" data-gap=\"sm\" data-align=\"center\" data-wrap=\"true\">\n  <span data-ui=\"badge\">Sent</span>\n  <span data-ui=\"badge\" data-variant=\"secondary\">Draft</span>\n  <span data-ui=\"badge\" data-variant=\"destructive\">Overdue</span>\n  <span data-ui=\"badge\" data-variant=\"outline\">Paid</span>\n</div>"
    },
    {
      "name": "Card",
      "ui": "card",
      "category": "Layout",
      "description": "A bordered panel with header, title, description, action, content and footer parts.",
      "props": [],
      "snippet": "<div data-ui=\"card\">\n  <div data-part=\"header\">\n    <div data-ui=\"stack\" data-gap=\"xs\">\n      <h3 data-part=\"title\">Invoice TB-1042</h3>\n      <p data-part=\"description\">Northline Studio, issued 12 February.</p>\n    </div>\n    <div data-part=\"action\"><span data-ui=\"badge\" data-variant=\"secondary\">Pending</span></div>\n  </div>\n  <div data-part=\"content\">\n    <p data-ui=\"text\" data-size=\"sm\" data-tone=\"muted\">Six line items for the spring catalogue, plus a fixed project fee.</p>\n  </div>\n  <div data-part=\"footer\">\n    <button data-ui=\"button\" data-size=\"sm\">View invoice</button>\n    <button data-ui=\"button\" data-size=\"sm\" data-variant=\"outline\">Send reminder</button>\n  </div>\n</div>"
    },
    {
      "name": "Input",
      "ui": "input",
      "category": "Forms",
      "description": "A single-line text field with three sizes and an invalid state.",
      "props": [
        {
          "name": "size",
          "label": "Size",
          "type": "choice",
          "options": [
            "default",
            "sm",
            "lg"
          ],
          "default": "default"
        },
        {
          "name": "invalid",
          "label": "Invalid",
          "type": "boolean",
          "default": false
        }
      ],
      "snippet": "<div data-ui=\"stack\" data-gap=\"md\">\n  <div data-ui=\"field\">\n    <label data-part=\"label\" for=\"tb-invoice-number\">Invoice number</label>\n    <input data-ui=\"input\" id=\"tb-invoice-number\" type=\"text\" value=\"TB-1042\">\n    <p data-part=\"description\">Numbers increase automatically for each client.</p>\n  </div>\n  <div data-ui=\"field\">\n    <label data-part=\"label\" for=\"tb-client-email\">Client email</label>\n    <input data-ui=\"input\" id=\"tb-client-email\" type=\"email\" value=\"accounts@northline\" data-invalid=\"true\" aria-invalid=\"true\">\n    <p data-part=\"message\">Enter a full email address.</p>\n  </div>\n  <div data-ui=\"field\">\n    <label data-part=\"label\" for=\"tb-invoice-sm\">Search invoices</label>\n    <input data-ui=\"input\" data-size=\"sm\" id=\"tb-invoice-sm\" type=\"search\" placeholder=\"Client or number\">\n  </div>\n</div>"
    },
    {
      "name": "Textarea",
      "ui": "textarea",
      "category": "Forms",
      "description": "A multi-line text field that grows by row, with an invalid state.",
      "props": [
        {
          "name": "invalid",
          "label": "Invalid",
          "type": "boolean",
          "default": false
        }
      ],
      "snippet": "<div data-ui=\"stack\" data-gap=\"md\">\n  <div data-ui=\"field\">\n    <label data-part=\"label\" for=\"tb-invoice-note\">Note on the invoice</label>\n    <textarea data-ui=\"textarea\" id=\"tb-invoice-note\" rows=\"3\">Thanks for the quick turnaround on the spring shoot. Payment is due within fourteen days.</textarea>\n    <p data-part=\"description\">Shown under the totals on the PDF.</p>\n  </div>\n  <div data-ui=\"field\">\n    <label data-part=\"label\" for=\"tb-invoice-terms\">Payment terms</label>\n    <textarea data-ui=\"textarea\" id=\"tb-invoice-terms\" rows=\"2\" data-invalid=\"true\" aria-invalid=\"true\">Fourteen</textarea>\n    <p data-part=\"message\">Terms must be a whole number of days.</p>\n  </div>\n</div>"
    },
    {
      "name": "Label",
      "ui": "label",
      "category": "Forms",
      "description": "A form label at 14px medium, in a tight line height.",
      "props": [],
      "snippet": "<div data-ui=\"field\">\n  <label data-ui=\"label\" for=\"tb-label-client\">Client name</label>\n  <input data-ui=\"input\" id=\"tb-label-client\" type=\"text\" value=\"Northline Studio\">\n  <p data-part=\"description\">This name appears at the top of the PDF.</p>\n</div>"
    },
    {
      "name": "Field",
      "ui": "field",
      "category": "Forms",
      "description": "A stack of label, control, description and error message for one input.",
      "props": [],
      "snippet": "<div data-ui=\"field\">\n  <label data-part=\"label\" for=\"tb-field-email\">Billing email</label>\n  <input data-ui=\"input\" id=\"tb-field-email\" type=\"email\" value=\"sam@tallybook\" data-invalid=\"true\" aria-invalid=\"true\">\n  <p data-part=\"description\">Reminders and receipts go to this address.</p>\n  <p data-part=\"message\">Enter a full email address.</p>\n</div>"
    },
    {
      "name": "Select",
      "ui": "select",
      "category": "Forms",
      "description": "A native select styled to match the other fields, with two sizes.",
      "props": [
        {
          "name": "size",
          "label": "Size",
          "type": "choice",
          "options": [
            "default",
            "sm"
          ],
          "default": "default"
        }
      ],
      "snippet": "<div data-ui=\"field\">\n  <label data-part=\"label\" for=\"tb-select-currency\">Currency</label>\n  <select data-ui=\"select\" id=\"tb-select-currency\">\n    <option selected>US dollar</option>\n    <option>Pound sterling</option>\n    <option>Euro</option>\n    <option>Canadian dollar</option>\n  </select>\n  <p data-part=\"description\">New invoices use this currency.</p>\n</div>"
    },
    {
      "name": "Checkbox",
      "ui": "checkbox",
      "category": "Forms",
      "description": "A square checkbox with a drawn tick, sized to 16px.",
      "props": [],
      "snippet": "<div data-ui=\"stack\" data-gap=\"sm\">\n  <label data-ui=\"checkbox\" for=\"tb-check-reminder\">\n    <input type=\"checkbox\" id=\"tb-check-reminder\" checked>\n    <span>Send a reminder on the due date</span>\n  </label>\n  <label data-ui=\"checkbox\" for=\"tb-check-late\">\n    <input type=\"checkbox\" id=\"tb-check-late\">\n    <span>Add a 2 percent late fee after fourteen days</span>\n  </label>\n</div>"
    },
    {
      "name": "Radio group",
      "ui": "radio-group",
      "category": "Forms",
      "description": "A group of labelled radio buttons for choosing one option.",
      "props": [],
      "snippet": "<div data-ui=\"radio-group\" role=\"radiogroup\" aria-label=\"Invoice schedule\">\n  <span data-ui=\"label\">Invoice schedule</span>\n  <label for=\"tb-radio-weekly\">\n    <input type=\"radio\" name=\"tb-schedule\" id=\"tb-radio-weekly\" value=\"weekly\" checked>\n    <span>Weekly on Monday</span>\n  </label>\n  <label for=\"tb-radio-monthly\">\n    <input type=\"radio\" name=\"tb-schedule\" id=\"tb-radio-monthly\" value=\"monthly\">\n    <span>Monthly on the first</span>\n  </label>\n  <label for=\"tb-radio-manual\">\n    <input type=\"radio\" name=\"tb-schedule\" id=\"tb-radio-manual\" value=\"manual\">\n    <span>Only when I send it</span>\n  </label>\n</div>"
    },
    {
      "name": "Switch",
      "ui": "switch",
      "category": "Forms",
      "description": "A sliding toggle for a setting that applies at once.",
      "props": [],
      "snippet": "<div data-ui=\"stack\" data-gap=\"sm\">\n  <label data-ui=\"switch\" for=\"tb-switch-auto\">\n    <input type=\"checkbox\" role=\"switch\" id=\"tb-switch-auto\" checked>\n    <span>Send invoices automatically</span>\n  </label>\n  <label data-ui=\"switch\" for=\"tb-switch-vat\">\n    <input type=\"checkbox\" role=\"switch\" id=\"tb-switch-vat\">\n    <span>Show tax as a separate line</span>\n  </label>\n</div>"
    },
    {
      "name": "Slider",
      "ui": "slider",
      "category": "Forms",
      "description": "A range control with a filled track and a single round thumb.",
      "props": [],
      "snippet": "<div data-ui=\"field\">\n  <label data-ui=\"label\" for=\"tb-slider-days\">Reminder on day</label>\n  <input data-ui=\"slider\" id=\"tb-slider-days\" type=\"range\" min=\"1\" max=\"30\" value=\"14\" style=\"--value:45%\">\n  <p data-part=\"description\">Two weeks after the invoice is sent.</p>\n</div>"
    },
    {
      "name": "Toggle",
      "ui": "toggle",
      "category": "Forms",
      "description": "A two-state button that stays pressed until clicked again.",
      "props": [
        {
          "name": "variant",
          "label": "Variant",
          "type": "choice",
          "options": [
            "default",
            "outline"
          ],
          "default": "default"
        },
        {
