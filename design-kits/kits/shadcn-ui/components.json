      "snippet": "<div data-ui=\"stack\" data-gap=\"md\">\n  <h3 data-ui=\"heading\" data-level=\"4\">Invoice TB-1042</h3>\n  <p data-ui=\"text\" data-size=\"sm\" data-tone=\"muted\">Northline Studio, due Thursday 12 March.</p>\n  <div data-ui=\"stack\" data-direction=\"row\" data-gap=\"sm\" data-align=\"center\">\n    <button data-ui=\"button\" data-size=\"sm\">Send reminder</button>\n    <button data-ui=\"button\" data-variant=\"outline\" data-size=\"sm\">Edit</button>\n  </div>\n</div>"
    },
