            "center",
            "end"
          ],
          "default": "stretch"
        }
      ],
      "snippet": "<div data-ui=\"grid\" data-columns=\"3\" data-gap=\"md\">\n  <div data-ui=\"card\">\n    <div data-part=\"header\"><h3 data-ui=\"heading\" data-level=\"4\">Paid</h3></div>\n    <div data-part=\"content\"><p data-ui=\"text\" data-size=\"sm\" data-tone=\"muted\">Eight invoices cleared this month.</p></div>\n  </div>\n  <div data-ui=\"card\">\n    <div data-part=\"header\"><h3 data-ui=\"heading\" data-level=\"4\">Pending</h3></div>\n    <div data-part=\"content\"><p data-ui=\"text\" data-size=\"sm\" data-tone=\"muted\">Three sent, none viewed yet.</p></div>\n  </div>\n  <div data-ui=\"card\">\n    <div data-part=\"header\"><h3 data-ui=\"heading\" data-level=\"4\">Overdue</h3></div>\n    <div data-part=\"content\"><p data-ui=\"text\" data-size=\"sm\" data-tone=\"muted\">One invoice is nine days late.</p></div>\n  </div>\n</div>"
    },
    {
      "name": "Section",
      "ui": "section",
      "category": "Layout",
      "description": "A full-width band with block padding and content held to a reading width.",
      "props": [
        {
          "name": "padding",
          "label": "Padding",
          "type": "choice",
          "options": [
            "md",
            "sm",
            "lg"
          ],
          "default": "md"
        }
      ],
      "snippet": "<section data-ui=\"section\" data-padding=\"md\">\n  <h2 data-ui=\"heading\" data-level=\"2\">Invoices that send themselves</h2>\n  <p data-ui=\"text\" data-tone=\"muted\">Schedule a reminder once and Tallybook chases the client on the due date, then again a week later if the balance is open.</p>\n</section>"
    },
    {
      "name": "Heading",
      "ui": "heading",
      "category": "Layout",
      "description": "A display or section heading at one of five sizes, with tight tracking.",
      "props": [
        {
          "name": "level",
          "label": "Level",
          "type": "choice",
          "options": [
            "2",
            "1",
            "display",
            "3",
            "4"
          ],
          "default": "2"
        }
      ],
      "snippet": "<div data-ui=\"stack\" data-gap=\"sm\">\n  <h1 data-ui=\"heading\" data-level=\"display\">Get paid without the chase</h1>\n  <h1 data-ui=\"heading\" data-level=\"1\">Small studio invoicing</h1>\n  <h2 data-ui=\"heading\" data-level=\"2\">March invoices</h2>\n  <h3 data-ui=\"heading\" data-level=\"3\">Awaiting payment</h3>\n  <h4 data-ui=\"heading\" data-level=\"4\">Northline Studio</h4>\n</div>"
    },
    {
      "name": "Text",
      "ui": "text",
      "category": "Layout",
      "description": "Body copy at four sizes in a default or muted tone.",
      "props": [
        {
          "name": "size",
          "label": "Size",
          "type": "choice",
          "options": [
            "md",
            "sm",
            "lg",
            "xs"
          ],
          "default": "md"
        },
        {
          "name": "tone",
          "label": "Tone",
          "type": "choice",
          "options": [
            "default",
            "muted"
          ],
          "default": "default"
        }
      ],
      "snippet": "<div data-ui=\"stack\" data-gap=\"xs\">\n  <p data-ui=\"text\" data-size=\"lg\">Send a branded invoice in under a minute.</p>\n  <p data-ui=\"text\" data-size=\"md\">Every studio gets a numbered invoice, a due date and a PDF the client can open on a phone.</p>\n  <p data-ui=\"text\" data-size=\"sm\" data-tone=\"muted\">Late fees apply after fourteen days unless you turn them off.</p>\n  <p data-ui=\"text\" data-size=\"xs\" data-tone=\"muted\">Figures in this view are estimates until the invoice is issued.</p>\n</div>"
    },
    {
      "name": "Navbar",
      "ui": "navbar",
      "category": "Layout",
      "description": "A bar for brand, links and actions, optionally pinned to the top of the page.",
      "props": [
        {
          "name": "sticky",
          "label": "Sticky",
          "type": "boolean",
          "default": false
        }
      ],
      "snippet": "<nav data-ui=\"navbar\" data-sticky=\"true\">\n  <div data-part=\"brand\"><a href=\"#\">Tallybook</a></div>\n  <div data-part=\"links\">\n    <a href=\"#\">Invoices</a>\n    <a href=\"#\">Clients</a>\n    <a href=\"#\">Reports</a>\n  </div>\n  <div data-part=\"actions\">\n    <button data-ui=\"button\" data-size=\"sm\">New invoice</button>\n  </div>\n</nav>"
    },
    {
      "name": "Icon",
      "ui": "icon",
      "category": "Layout",
      "description": "A wrapper for a hand-written inline SVG, sized to 16px in the current text colour.",
      "props": [],
      "snippet": "<div data-ui=\"stack\" data-direction=\"row\" data-gap=\"md\" data-align=\"center\">\n  <span data-ui=\"icon\" aria-hidden=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"/><path d=\"M14 2v6h6\"/></svg></span>\n  <span data-ui=\"icon\" aria-hidden=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6 9 17l-5-5\"/></svg></span>\n  <button data-ui=\"button\" data-variant=\"outline\" data-size=\"sm\">\n    <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 5v14\"/><path d=\"M5 12h14\"/></svg>\n    Add line item\n  </button>\n</div>"
    },
