      ],
      "snippet": "<div data-ui=\"stack\" data-gap=\"md\">\n  <div data-ui=\"stack\" data-direction=\"row\" data-gap=\"sm\" data-align=\"center\" data-wrap=\"true\">\n    <button data-ui=\"button\">Send invoice</button>\n    <button data-ui=\"button\" data-variant=\"destructive\">Void invoice</button>\n    <button data-ui=\"button\" data-variant=\"outline\">Preview</button>\n    <button data-ui=\"button\" data-variant=\"secondary\">Save draft</button>\n    <button data-ui=\"button\" data-variant=\"ghost\">Cancel</button>\n    <button data-ui=\"button\" data-variant=\"link\">View history</button>\n  </div>\n  <div data-ui=\"stack\" data-direction=\"row\" data-gap=\"sm\" data-align=\"center\" data-wrap=\"true\">\n    <button data-ui=\"button\" data-size=\"sm\">Small</button>\n    <button data-ui=\"button\">Default</button>\n    <button data-ui=\"button\" data-size=\"lg\">Large</button>\n    <button data-ui=\"button\" data-size=\"icon\" aria-label=\"Add invoice\">\n      <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 5v14\"/><path d=\"M5 12h14\"/></svg>\n    </button>\n    <button data-ui=\"button\" disabled>Disabled</button>\n  </div>\n</div>"
    },
    {
