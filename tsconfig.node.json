{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "composite": true,
    "resolveJsonModule": true
  },
  "include": ["src/main/**/*", "src/preload/**/*", "src/shared/**/*", "src/renderer/src/palette.ts", "src/renderer/src/live.ts", "src/renderer/src/todo.ts", "src/renderer/src/streaming.ts", "src/renderer/src/genui/types.ts", "src/renderer/src/genui/formula.ts", "src/renderer/src/genui/validate.ts", "src/renderer/src/genui/lines.ts", "src/renderer/src/cmdline.ts", "src/renderer/src/event-order.ts", "src/renderer/src/fileref.ts", "src/renderer/src/layout.ts", "src/renderer/src/splitter.ts", "src/renderer/src/sections.ts", "src/renderer/src/mentions.ts", "src/renderer/src/modes.ts", "src/renderer/src/commands.ts", "src/renderer/src/turns.ts", "src/renderer/src/question-card.ts", "src/renderer/src/windowing.ts", "src/renderer/src/design/pages.ts", "src/renderer/src/design/board-layout.ts", "src/renderer/src/design/contrast.ts", "src/renderer/src/design/highlight.ts", "scripts/**/*", "test/**/*", "evals/**/*", "bench/**/*", "electron.vite.config.ts", "vitest.config.ts"],
  "exclude": ["test/**/*.tsx"]
}
