# Optional native-provider evaluations. Not needed to build or run the UI preview.
# Copy to .env and configure your own provider. Never commit real credentials.
EVAL_API_KEY=
EVAL_BASE_URL=https://api.example.com/v1
EVAL_MODEL=your-model-id
# openai-chat | openai-responses | anthropic-messages
EVAL_PROTOCOL=openai-chat

# Optional live integration tests. These run only with explicit opt-in and all
# required values set; they can incur API charges. Use a test account.
CUBIQ_LIVE_TESTS=0
LIVE_API_KEY=
LIVE_BASE_URL=https://api.example.com/v1
LIVE_MODEL=your-model-id
LIVE_PROTOCOL=openai-chat
